{
  "name": "@kttf/shared",
  "version": "0.1.0",
  "private": true,
  "description": "KTTF — общий код для kttf-back и kttf-front: движок рейтинга, генерация сеток, типы, конфигурация.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rating": {
      "types": "./dist/rating/index.d.ts",
      "default": "./dist/rating/index.js"
    },
    "./config/tsconfig.base.json": "./config/tsconfig.base.json",
    "./config/eslint": "./config/eslint.preset.js",
    "./config/prettier": "./config/prettier.json"
  },
  "files": [
    "dist",
    "config"
  ],
  "prettier": "./config/prettier.json",
  "scripts": {
    "prepare": "pnpm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:adr": "vitest run tests/",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
